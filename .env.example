# Railway: referenciar la variable MYSQL_URL del servicio MySQL
DATABASE_URL=mysql://usuario:contrasena@localhost:3306/f1
# Crea una clave aleatoria larga; no la compartas ni la pongas en Netlify
ADMIN_API_KEY=cambia-por-una-clave-larga-y-aleatoria
# Permite acceder directamente a la API desde este origen (el proxy Netlify no lo requiere)
CORS_ORIGIN=http://localhost:8888
PORT=1234
