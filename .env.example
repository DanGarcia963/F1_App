# Conexión desde Supabase > Connect; solo en Railway (no compartir la clave)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
ADMIN_API_KEY=crea-una-clave-larga-y-aleatoria
CORS_ORIGIN=https://TU-SITIO.netlify.app
PG_POOL_SIZE=5

# Verificación TLS recomendada: descargar CA oficial desde
# Supabase > Project Settings > Database > SSL Configuration.
PGSSL_MODE=verify-full
# En Railway, pegar el contenido PEM completo (BEGIN CERTIFICATE ... END CERTIFICATE)
# SUPABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Solo para resolver temporalmente un bloqueo de certificado mientras
# configuras la CA: cifra datos pero NO verifica la identidad del servidor.
# PGSSL_MODE=require

# Local sin TLS, solo NODE_ENV != production y localhost:
# PGSSL_MODE=disable
